{
  "name": "govengers-ui",
  "private": true,
  "description": "Browsable, copy-paste Vue components, blocks and page recipes for govengers applications. Not a package: copy what you need.",
  "type": "module",
  "scripts": {
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "index": "bun scripts/index.ts",
    "contrast": "bun scripts/contrast.ts",
    "lint": "bun scripts/ui-lint.ts ui pages",
    "test": "bun test scripts ui demo/src",
    "demo": "vite --config demo/vite.config.ts",
    "build": "vite build --config demo/vite.config.ts",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
